+package contracts
+
+import (
+	"github.com/gin-gonic/gin"
+	"sync"
+	"testing"
+)
+
+type runtimeSettingsProviderStub struct {
+	calls int
+	keys  []BusinessSettingDefinition
+}
+
+func (p *runtimeSettingsProviderStub) BusinessReaderFor(_ *gin.Context, definitions []BusinessSettingDefinition) (BusinessRuntimeSettingsReader, error) {
+	p.calls++
+	p.keys = definitions
+	return runtimeSettingsReaderStub{}, nil
+}
+
+type runtimeSettingsReaderStub struct{}
+
+func (runtimeSettingsReaderStub) GetByKey(string) (string, error) { return "", nil }
+func runtimeSettingsSeeds() []BusinessSettingSeed {
+	return []BusinessSettingSeed{{Key: "cmdb.ssh.port", Value: "22", ValueType: "number", GroupKey: "cmdb", Remark: "SSH port"}, {Key: "cmdb.ssh.timeout", Value: "10", ValueType: "number", GroupKey: "cmdb", Remark: "SSH timeout"}}
+}
+func newRuntimeSettingsRegistry() *businessSettingsRegistry {
+	return &businessSettingsRegistry{modules: make(map[string][]BusinessSettingDefinition)}
+}
+
+func TestBusinessRuntimeSettingsDeclarationOwnership(t *testing.T) {
+	for _, namespace := range []string{"site", "platform", "system", "login", "audit", "upload", "mail", "sms", "i18n", "ui", "org", "iam", "auth", "setting", "dict", "notification", "security"} {
+		registry := newRuntimeSettingsRegistry()
+		seeds := []BusinessSettingSeed{{Key: namespace + ".custom", Value: "1", ValueType: "number", GroupKey: namespace, Remark: "reserved namespace probe"}}
+		if registry.register("business."+namespace, seeds) == nil || len(registry.modules) != 0 {
+			t.Fatalf("reserved namespace accepted or mutated registry: %s", namespace)
+		}
+	}
+
+	for _, module := range []string{"cmdb", "business.site", "business.platform", "business.system", "business.cmdb ", "business.a.b"} {
+		if newRuntimeSettingsRegistry().register(module, runtimeSettingsSeeds()) == nil {
+			t.Fatalf("invalid module accepted: %s", module)
+		}
+	}
+	for _, key := range []string{"login.password", "cmdb", "cmdb.ssh..port", "cmdb.ssh.port ", "cmdbx.ssh.port"} {
+		seeds := runtimeSettingsSeeds()
+		seeds[0].Key = key
+		r := newRuntimeSettingsRegistry()
+		if r.register("business.cmdb", seeds) == nil || len(r.modules) != 0 {
+			t.Fatalf("foreign or malformed key accepted: %s", key)
+		}
+	}
+	seeds := runtimeSettingsSeeds()
+	seeds[1].Key = seeds[0].Key
+	r := newRuntimeSettingsRegistry()
+	if r.register("business.cmdb", seeds) == nil || len(r.modules) != 0 {
+		t.Fatal("duplicate batch partially registered")
+	}
+	for _, field := range []string{"type", "group", "remark"} {
+		seeds := runtimeSettingsSeeds()
+		switch field {
+		case "type":
+			seeds[0].ValueType = "secret"
+		case "group":
+			seeds[0].GroupKey = ""
+		case "remark":
+			seeds[0].Remark = ""
+		}
+		if newRuntimeSettingsRegistry().register("business.cmdb", seeds) == nil {
+			t.Fatalf("invalid %s accepted", field)
+		}
+	}
+}
+
+func TestBusinessRuntimeSettingsFrozenCopiesAndProvider(t *testing.T) {
+	r := newRuntimeSettingsRegistry()
+	seeds := runtimeSettingsSeeds()
+	if err := r.register("business.cmdb", seeds); err != nil {
+		t.Fatal(err)
+	}
+	seeds[0].Value = "changed"
+	if r.register("business.cmdb", runtimeSettingsSeeds()) == nil {
+		t.Fatal("duplicate module accepted")
+	}
+	provider := &runtimeSettingsProviderStub{}
+	if r.registerProvider(provider) == nil {
+		t.Fatal("provider installed before seal")
+	}
+	snapshot := r.seal()
+	if snapshot[0].Value != "22" {
+		t.Fatal("caller seed mutation changed registry")
+	}
+	snapshot[0].Value = "tampered"
+	if r.seal()[0].Value != "22" {
+		t.Fatal("returned snapshot mutation changed registry")
+	}
+	if r.register("business.deploy", []BusinessSettingSeed{{Key: "deploy.limit", ValueType: "number", Value: "1", GroupKey: "deploy", Remark: "limit"}}) == nil {
+		t.Fatal("late registration accepted")
+	}
+	if _, err := r.readerFor("business.cmdb", nil); err == nil {
+		t.Fatal("reader available before provider")
+	}
+	var typedNil *runtimeSettingsProviderStub
+	if r.registerProvider(typedNil) == nil {
+		t.Fatal("typed nil provider accepted")
+	}
+	if err := r.registerProvider(provider); err != nil {
+		t.Fatal(err)
+	}
+	if r.registerProvider(provider) == nil {
+		t.Fatal("provider replacement accepted")
+	}
+	if _, err := r.readerFor("business.deploy", nil); err == nil || provider.calls != 0 {
+		t.Fatal("unknown module reached provider")
+	}
+	if _, err := r.readerFor("business.cmdb", nil); err != nil {
+		t.Fatal(err)
+	}
+	provider.keys[0].Value = "changed"
+	if r.seal()[0].Value != "22" {
+		t.Fatal("provider mutated registry")
+	}
+}
+
+func TestBusinessRuntimeSettingsConcurrentCollision(t *testing.T) {
+	r := newRuntimeSettingsRegistry()
+	var wg sync.WaitGroup
+	results := make(chan error, 8)
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); results <- r.register("business.cmdb", runtimeSettingsSeeds()) }()
+	}
+	wg.Wait()
+	close(results)
+	success := 0
+	for err := range results {
+		if err == nil {
+			success++
+		}
+	}
+	if success != 1 || len(r.seal()) != 2 {
+		t.Fatalf("collision not atomic: successes=%d", success)
+	}
+}

diff --git a/backend/modules/system/config/setting/business_runtime_settings.go b/backend/modules/system/config/setting/business_runtime_settings.go
new file mode 100644
--- /dev/null
+++ b/backend/modules/system/config/setting/business_runtime_settings.go
@@ -0,0 +1,161 @@
+package setting
+
+import (
+	"context"
+	"sort"
+	"strings"
+
+	"github.com/duanxldragon/pantheon-base/backend/pkg/contracts"
+	"github.com/duanxldragon/pantheon-base/backend/pkg/tenant"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// BootstrapBusinessSettings prepares only declared business defaults. It is a
+// separate required stage, because the legacy system runner logs seed errors.
+func (s *SettingService) BootstrapBusinessSettings(definitions []contracts.BusinessSettingDefinition) error {
+	if s == nil || s.db == nil {
+		return contracts.ErrBusinessSettings
+	}
+	definitions = append([]contracts.BusinessSettingDefinition(nil), definitions...)
+	sort.Slice(definitions, func(i, j int) bool { return definitions[i].Key < definitions[j].Key })
+	for _, definition := range definitions {
+		root := strings.SplitN(definition.Key, ".", 2)[0]
+		for _, core := range settingSeeds() {
+			if strings.SplitN(core.SettingKey, ".", 2)[0] == root {
+				return contracts.ErrBusinessSettings
+			}
+		}
+	}
+	return s.db.Transaction(func(tx *gorm.DB) error {
+		for _, definition := range definitions {
+			value, err := validateAndNormalizeSettingValue(definition.Key, definition.ValueType, definition.Value)
+			if err != nil {
+				return contracts.ErrBusinessSettings
+			}
+			row := SystemSetting{SettingKey: definition.Key, SettingValue: value, ValueType: definition.ValueType, GroupKey: definition.GroupKey, Module: definition.Module, Remark: definition.Remark}
+			if err := tx.Clauses(clause.OnConflict{Columns: []clause.Column{{Name: "tenant_id"}, {Name: "setting_key"}}, DoNothing: true}).Create(&row).Error; err != nil {
+				return err
+			}
+			var stored SystemSetting
+			if err := tx.Where("tenant_id = 0 AND setting_key = ?", definition.Key).First(&stored).Error; err != nil {
+				return err
+			}
+			if !validBusinessSettingRow(stored, definition) {
+				return contracts.ErrBusinessSettings
+			}
+		}
+		return nil
+	})
+}
+
+// MigrateBusinessSettings is used only in the opt-in auto-migrate startup mode.
+func (s *SettingService) MigrateBusinessSettings(definitions []contracts.BusinessSettingDefinition) error {
+	if s == nil || s.db == nil {
+		return contracts.ErrBusinessSettings
+	}
+	if err := s.db.AutoMigrate(&SystemSetting{}); err != nil {
+		return err
+	}
+	return s.BootstrapBusinessSettings(definitions)
+}
+
+func validBusinessSettingRow(row SystemSetting, definition contracts.BusinessSettingDefinition) bool {
+	if row.SettingKey != definition.Key || row.Module != definition.Module || row.ValueType != definition.ValueType || row.GroupKey != definition.GroupKey || row.IsPublic != 0 || row.IsEncrypted != 0 {
+		return false
+	}
+	_, err := validateAndNormalizeSettingValue(definition.Key, definition.ValueType, row.SettingValue)
+	return err == nil
+}
+
+type businessRuntimeSettingReader struct {
+	db           *gorm.DB
+	ctx          context.Context
+	snapshot     *tenant.Context
+	expectedMode string
+	definitions  map[string]contracts.BusinessSettingDefinition
+}
+
+// BusinessReaderFor snapshots middleware tenancy. It never uses request body or
+// raw headers to invent a tenant; compiled callers must use the trusted chain.
+func (s *SettingService) BusinessReaderFor(c *gin.Context, definitions []contracts.BusinessSettingDefinition) (contracts.BusinessRuntimeSettingsReader, error) {
+	if s == nil || s.db == nil || c == nil || c.Request == nil || len(definitions) == 0 {
+		return nil, contracts.ErrBusinessSettings
+	}
+	reader := &businessRuntimeSettingReader{db: s.db, ctx: c.Request.Context(), expectedMode: tenant.ModeCompat, definitions: make(map[string]contracts.BusinessSettingDefinition, len(definitions))}
+	if bound := tenant.FromGin(c); bound != nil {
+		snapshot := *bound
+		if !validBusinessSettingContext(snapshot) {
+			return nil, contracts.ErrBusinessSettings
+		}
+		reader.snapshot = &snapshot
+		reader.expectedMode = snapshot.Mode
+	}
+	for _, definition := range definitions {
+		reader.definitions[definition.Key] = definition
+	}
+	if err := reader.checkMode(); err != nil {
+		return nil, err
+	}
+	return reader, nil
+}
+
+func validBusinessSettingContext(ctx tenant.Context) bool {
+	switch ctx.Mode {
+	case tenant.ModeCompat:
+		return ctx.TenantID == 0 && ctx.ResolvedBy == tenant.ResolvedByCompatFallback
+	case tenant.ModeMulti:
+		switch ctx.ResolvedBy {
+		case tenant.ResolvedByHeader:
+			return true
+		case tenant.ResolvedBySubject:
+			return ctx.TenantID > 0
+		case tenant.ResolvedByPlatformFallback:
+			return ctx.TenantID == 0
+		}
+	}
+	return false
+}
+
+func (r *businessRuntimeSettingReader) checkMode() error {
+	if err := r.ctx.Err(); err != nil {
+		return err
+	}
+	modeReader := tenant.NewStrictSettingModeReader(NewSettingService(r.db.WithContext(r.ctx)))
+	current, err := modeReader.ReadMode(r.ctx)
+	if err != nil || current != r.expectedMode {
+		return contracts.ErrBusinessSettings
+	}
+	if current == tenant.ModeMulti && r.snapshot == nil {
+		return contracts.ErrBusinessSettings
+	}
+	return nil
+}
+
+func (r *businessRuntimeSettingReader) GetByKey(key string) (string, error) {
+	definition, ok := r.definitions[key]
+	if !ok {
+		return "", contracts.ErrBusinessSettings
+	}
+	if err := r.checkMode(); err != nil {
+		return "", err
+	}
+	view := &SettingService{db: r.db.WithContext(r.ctx), Scoper: tenant.Scoper{TenantCtx: r.snapshot}}
+	var rows []SystemSetting
+	if err := view.tenantScope()(view.db).Where("setting_key = ?", key).Order("tenant_id asc").Find(&rows).Error; err != nil {
+		return "", contracts.ErrBusinessSettings
+	}
+	if len(rows) == 0 {
+		return "", contracts.ErrBusinessSettings
+	}
+	for _, row := range rows {
+		if !validBusinessSettingRow(row, definition) {
+			return "", contracts.ErrBusinessSettings
+		}
+	}
+	if err := r.ctx.Err(); err != nil {
+		return "", err
+	}
+	return rows[len(rows)-1].SettingValue, nil
+}

